# Настройки Kibborg Go Engine — редактируй этот файл, чтобы выбрать модель и параметры. Код править не нужно!
# После изменений перезапусти стек (Stop затем Start или через Меню).

# === МОДЕЛЬ МОЗГА (llama-server) ===
# Полный путь к GGUF. Меняй здесь ИЛИ из вкладки «Модели» / команды /models.
# По умолчанию: Qwen3.6-35B-A3B (Unsloth UD-IQ4_XS) — агент + vision.
MODEL_PATH=models\brain\Qwen3.6-35B-A3B\Qwen3.6-35B-A3B-UD-IQ4_XS.gguf

# mmproj для зрения. Пусто = текст only. auto = mmproj рядом с MODEL_PATH.
MMPROJ_PATH=models\brain\Qwen3.6-35B-A3B\mmproj-BF16.gguf
# MMPROJ_PATH=auto

# === ИСПОЛНЯЕМЫЙ ФАЙЛ LLAMA-SERVER (ОБЯЗАТЕЛЬНО) ===
# Путь к llama-server.exe из твоей сборки llama.cpp с поддержкой CUDA.
# Варианты:
# - Положи llama-server.exe (и нужные .dll из той же папки) в engine-go и оставь .\llama-server.exe
# - Или укажи ПОЛНЫЙ путь к твоей сборке (рекомендуется, если не хочешь копировать ~1 ГБ CUDA-библиотек):
#   LLAMA_SERVER=D:\llama.cpp\cuda-bin-b9550\llama-server.exe
# DLL'ки (ggml-cuda.dll, cublas*.dll и т.д.) будут автоматически искаться в той же папке, где лежит exe.
# Если используешь свою сборку — просто поменяй путь ниже на свой.
LLAMA_SERVER=D:\llama.cpp\cuda-bin-b9550\llama-server.exe

# === ПОРТЫ ===
# Не используй 8080 — часто занят другими локальными проектами.
PORT_BRAIN=8083
PORT_ENGINE=8002

# === ПАРАМЕТРЫ LLAMA-SERVER (настрой под железо) ===
LLAMA_THREADS=28
LLAMA_CTX_SIZE=32768
LLAMA_GPU_LAYERS=99
# 1 = макс. скорость чата; 4+ = много KV-кэша, decode тормозит на 12 GB GPU
LLAMA_PARALLEL=1
# off = без thinking (быстро); on = длинные «размышления» Qwen
LLAMA_REASONING=off

# --- GPU (критично для лагов UI) ---
# Qwen 35B на обе 3060: DEVICE пустой + TENSOR_SPLIT. Больше веса на свободную GPU1.
LLAMA_DEVICE=
LLAMA_TENSOR_SPLIT=0.35,0.65
LLAMA_MAIN_GPU=0
# KV cache q8_0 вместо f16: меньше VRAM/bandwidth на 12 GB картах.
LLAMA_CACHE_TYPE_K=q8_0
LLAMA_CACHE_TYPE_V=q8_0

# === GO ДВИЖОК (внутренний) ===
# Здесь модели нет — Go-бинарник содержит только детерминированную логику инструментов

# === TELEGRAM BOT (pure Go, inside the same kibborg-go-engine binary) ===
# 1. Создай бота в @BotFather, скопируй токен.
# 2. Раскомментируй и вставь ниже свою строку:
TELEGRAM_TOKEN=
# 3. Запусти Start.cmd (или Menu -> 5).
# Бинарь поднимет и HTTP tools на 8002, и Telegram бота в горутине.
# Бот отвечает на тикеры и /analyze SYMBOL, используя детерминированный Go engine.

TELEGRAM_ID=

# === РУКИ АГЕНТА (безопасность) ===
# Режим рук (safe / full) в ini НЕ задаётся: он переключается на лету — командой /hands в
# Telegram или тумблером в веб-панели — и живёт в runtime/hands_mode.json. По умолчанию safe:
# опасные действия (удаление вне рабочих папок, запись в settings.ini/.git/автозагрузку,
# неразбираемые команды вроде -EncodedCommand) спрашивают подтверждение «да / нет».
# В режиме full подтверждений нет, но ядерные команды (format, diskpart, bcdedit, shutdown,
# снос корня диска) и переводы средств заблокированы всегда.
#
# AGENT_HANDS_ROOTS — дополнительные каталоги, где агент пишет и удаляет БЕЗ подтверждения.
# Разделитель ; или , . Проект, Рабочий стол и engine-go\runtime разрешены и без этой строки.
# Пример: AGENT_HANDS_ROOTS=D:\work\scratch;E:\dumps
AGENT_HANDS_ROOTS=

# Журналы решений агента (ротация на 5 МБ, одна предыдущая копия *.jsonl.1):
#   runtime\hands.jsonl — почему инструмент разрешён/запрещён/спрошен (taskID, rule, reason)
#   runtime\tasks.jsonl — одна строка на задачу: вход, паки, шаги, инструменты, исход
# Посмотреть разбором: /logs runtime/hands.jsonl

# === ГОЛОС (TypeWhisper primary + whisper.cpp fallback) ===
# Telegram voice / Web 🎙 → STT → обычный чат с LLM.
#
# 1) TypeWhisper for Windows (рекомендуется):
#    https://github.com/TypeWhisper/typewhisper-win
#    - Settings → Advanced → API Server ON (порт 8978)
#    - Локальная модель: Whisper Large V3 Turbo (качество + скорость, ru/en)
#    - Пустой TYPEWHISPER_URL = auto-discover (%LOCALAPPDATA%\TypeWhisper\api-discovery.json) → :8978
#    - TYPEWHISPER_URL=off — полностью отключить TypeWhisper
TYPEWHISPER_URL=
TYPEWHISPER_TOKEN=
#
# 2) whisper.cpp fallback (если TypeWhisper не запущен):
# Пример: WHISPER_SERVER=D:\whisper.cpp\whisper-server.exe
WHISPER_SERVER=
# Пример: WHISPER_MODEL=models\whisper\ggml-large-v3-turbo.bin
WHISPER_MODEL=
PORT_WHISPER=8081
# Путь к ffmpeg (пусто = искать в PATH)
FFMPEG=

# === ЗАВЕРШЕНИЕ РАБОТЫ ===
# true = при выходе бота гасить запущенный ИМ llama-server (по умолчанию false — модель
# остаётся тёплой в VRAM между перезапусками бота).
STOP_BRAIN_ON_EXIT=false

# === ВЕБ-ИНТЕРФЕЙС ===
# Локальная панель (чат, /analyze, browser, download video, статус) на http://127.0.0.1:<порт>.
# Доступна только с этого компьютера. 0 = выключить.
# Паритет с Telegram: новые фичи бота добавляются и сюда (см. AGENTS.md).
PORT_WEB=8090

# === ВИДЕО (yt-dlp + ffmpeg) ===
# Скачивание YouTube / Instagram / TikTok: нужен yt-dlp в PATH или `pip install yt-dlp`.
# ffmpeg (ниже) нужен для склейки лучшего video+audio в один mp4.
# FFMPEG=  — уже есть в секции голоса; тот же путь используется download_video.
#
# РАЗБОР видео (пришли ролик в чат или скажи «разбери D:\урок.mp4») требует ffmpeg И ffprobe.
# ffprobe ищется рядом с ffmpeg, иначе в PATH. Установка одной командой:
#     winget install Gyan.FFmpeg
# Речь берётся тем же STT, что и голосовые (секция выше), кадры — тем же зрением, что и
# картинки (MMPROJ_PATH). Своих настроек у слоя видео нет: он собран из уже настроенного.

# === ДОКУМЕНТЫ: PDF И СКАНЫ ===
# Пришли PDF в чат (или скажи «прочитай D:\архив\акт.pdf») — возьму текстовый слой, а если
# внутри скан, распознаю страницы. Нужны две вещи, обе ставятся одной командой:
#     winget install oschwartz10612.Poppler          # pdftotext / pdftoppm / pdfinfo
#     winget install UB-Mannheim.TesseractOCR        # распознавание текста с картинки
# Пути ищутся сами (PATH, каталоги winget, стандартная установка). Задавай, только если
# положил их куда-то нестандартно:
POPPLER_DIR=
TESSERACT=
#
# ЯЗЫКИ РАСПОЗНАВАНИЯ. Tesseract из коробки обычно несёт только английский, и на русском
# скане молча выдаёт латинскую кашу вместо кириллицы. Русский пакет кладётся рядом с движком
# (права администратора не нужны):
#     runtime\tessdata\rus.traineddata   — качается с github.com/tesseract-ocr/tessdata
# Каталог по умолчанию — runtime\tessdata; переопредели, если языки лежат в другом месте:
TESSDATA_DIR=

# === ДОЛГОВРЕМЕННАЯ ПАМЯТЬ (SQLite + опциональные эмбеддинги) ===
# Бот помнит диалог дольше короткого окна: хранит прошлые обмены в runtime/memory.db,
# ведёт краткую сводку по каждому чату и подмешивает релевантные фрагменты в ответ.
# true = включено (по умолчанию). false = только короткое окно, как раньше.
MEMORY_ENABLED=true
# Векторный поиск по памяти. Без EMBED_MODEL память работает на поиске по ключевым словам;
# с embedding-моделью — по смыслу (точнее вспоминает). Модель маленькая (bge/e5/nomic, ~100-500 МБ).
# Пример: EMBED_MODEL=models\embed\bge-m3-Q4_K_M.gguf
EMBED_MODEL=
# llama-server.exe для embed-модели. Пусто = тот же, что LLAMA_SERVER.
EMBED_SERVER=
# Отдельный порт embed-сервера (он не может одновременно и чатиться, и отдавать эмбеддинги).
PORT_EMBED=8082
EMBED_GPU_LAYERS=99

# === ТРЕЙДЕР (размер позиции /size и журнал /journal) ===
# Параметры по умолчанию для расчёта размера позиции по риску. Их можно переопределить прямо
# в команде: /size BTC entry=50000 stop=49000 risk=1.5 lev=10 balance=1000
# Размер счёта в валюте котировки (напр. USDT). 0 = не задан (тогда указывай balance= в /size).
TRADE_BALANCE=0
# Риск на сделку в % от счёта (классика 1–2%).
TRADE_RISK_PCT=1.0
# Плечо по умолчанию (1 = спот/без плеча).
TRADE_LEVERAGE=1
# Maintenance margin rate для оценки цены ликвидации (Binance USDT-M ~0.004–0.005).
TRADE_MMR=0.005
# Журнал сделок пишется в runtime/journal.db (SQLite). /log записать · /journal статистика · /close <id> <цена>.
